node_modules/
sandbox/dist/
.DS_Store

# .NET build output for core/
core/**/bin/
core/**/obj/

# Agents' git worktrees (Claude Code)
.claude/worktrees/

# The Performance Testing package writes these during a build (left behind if one fails)
unity/Assets/Resources/PerformanceTestRun*

# The playtest bot's raw runs (findings and screenshots worth keeping go in playtest/findings)
playtest/runs/

# Sound renders for audition (sound-design skill): listened to, never committed
tools/sound-audition/
tools/voice-samples/out/
__pycache__/

# The PM working copy of the board
/.pm/

# The unity CLI's Editor server settings (com.unity.pipeline). Every authored field is the package's
# default, which it uses when the file is missing; the rest is this Editor's own Run In Background
# bookkeeping, which editor.playmode set_run_in_background rewrites on every call (#81).
unity/ProjectSettings/Packages/com.unity.pipeline/EditorPipelineConfig.json

# punchy-sync build output
tools/punchy-sync/bin/
tools/punchy-sync/obj/

# A generated map's bake (GeneratedMap.Bake): its folder commits only its world file, map.json
/world/maps/nine/*
!/world/maps/nine/map.json
/world/maps/scale-12x10/*
!/world/maps/scale-12x10/map.json
/world/maps/world-12x10/*
!/world/maps/world-12x10/map.json
