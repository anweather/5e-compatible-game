<Project Sdk="Microsoft.NET.Sdk">
  <!-- holdcurve (docs/design/the-hold.md, phase 4): seeded runs of the Hold with scripted wizards and no view, for the curve.
       It isn't a gate: run it by hand when you turn a dial. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>holdcurve</AssemblyName>
    <RootNamespace>Chem.HoldCurve</RootNamespace>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Game.Core/Game.Core.csproj" />
  </ItemGroup>
</Project>
