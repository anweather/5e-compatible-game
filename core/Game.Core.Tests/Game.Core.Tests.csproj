<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the Unity EditMode tests for Chemistry under `dotnet test`. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../unity/Assets/Prototype/Chemistry/Tests/*.cs" Link="Tests/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Game.Core/Game.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- NUnit 3, like Unity's Test Framework (NUnit 4 moved CollectionAssert). -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
