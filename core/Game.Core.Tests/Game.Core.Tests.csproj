<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the Unity EditMode tests for Chemistry under `dotnet test`. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Fixtures run side by side, and they make whole worlds: on the workstation collector they wait on it, and run slower than one at a time (#162). -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../unity/Assets/Prototype/Chemistry/Tests/*.cs" Link="Tests/%(Filename)%(Extension)" />
    <!-- How they run here (#162): only this project's, so Unity's runner never reads it. -->
    <Compile Include="Parallel.cs" />
    <Compile Include="../TestParallel.cs" Link="TestParallel.cs" />
    <!-- The playtest bot's tests (its logic is in Game.Core; playtest/DESIGN.md). -->
    <Compile Include="../../unity/Assets/Prototype/Scripts/Playtest/Editor/*Tests.cs" Link="Playtest/Tests/%(Filename)%(Extension)" />
    <!-- The tools' tests are their own projects (Rules.Mcp.Tests, Playtest.Runner.Tests, Chat.Bench.Tests,
         Hold.Runner.Tests), which reference this one for the helpers above; Friends.cs lets them. -->
    <Compile Include="Friends.cs" />
    <Compile Include="TestKinds.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Game.Core/Game.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- NUnit 3, like Unity's Test Framework (NUnit 4 moved CollectionAssert). -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
