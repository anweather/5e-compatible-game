<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Chemistry tests of the land alone: hills, ChunkGen, world plans, themes, maps (Chem.Tests.props). It builds on
       Chem.Land and nothing above it, no World, no Rules, no ChemistryTests: a test that needs those is in its
       fixture's *WorldTests.cs half, in Chem.LandWorld.Tests (docs/design/chem-land-split.md, 5b). -->
  <Import Project="../Chem.Tests.props" />

  <ItemGroup>
    <Compile Include="@(ChemTestsLand)" Link="Tests/%(Filename)%(Extension)" />
    <Compile Include="*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Chem.Land/Chem.Land.csproj" />
  </ItemGroup>
</Project>
