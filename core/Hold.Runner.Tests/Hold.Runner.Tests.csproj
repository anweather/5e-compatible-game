<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Hold curve runner's tests (core/Hold.Runner). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <!-- Fixtures side by side, as in the Chem.*.Tests (#162). -->
    <Compile Include="../TestParallel.cs" Link="TestParallel.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Chemistry tests' shared helpers (ChemistryTests.Folders, ComboTests.Blank...), which Unity compiles with
         them: NUnit runs only this assembly's own tests, so none of theirs run twice. -->
    <ProjectReference Include="../Chem.Shared.Tests/Chem.Shared.Tests.csproj" />
    <ProjectReference Include="../Hold.Runner/Hold.Runner.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- As the Chem.*.Tests: NUnit 3, like Unity's Test Framework. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
