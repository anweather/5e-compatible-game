<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Chemistry tests' shared fixture (ChemistryTests: the rules, folders and rooms every other test uses) and EveryFixtureHasAKind. Chem.Tests.props says which project holds which tests. -->
  <Import Project="../Chem.Tests.props" />

  <ItemGroup>
    <Compile Include="@(ChemTestsShared)" Link="Tests/%(Filename)%(Extension)" />
    <Compile Include="*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The core: every Chemistry test project but the land's reaches it through this one (Chem.Tests.props). -->
    <ProjectReference Include="../Game.Core/Game.Core.csproj" />
  </ItemGroup>
</Project>
