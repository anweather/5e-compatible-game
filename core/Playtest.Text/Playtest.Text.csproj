<Project Sdk="Microsoft.NET.Sdk">
  <!-- The cheap playtester's world (playtest/cheap/README.md): an MCP server that lets a model
       play the core on the stand-in valley through text alone. Links nothing of Unity's. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Playtest.Text</AssemblyName>
    <RootNamespace>Chem.PlaytestText</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Game.Core/Game.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
  </ItemGroup>
</Project>
