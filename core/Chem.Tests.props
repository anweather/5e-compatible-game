<Project>
  <!--
    The Chemistry tests (unity/Assets/Prototype/Chemistry/Tests, which Unity compiles as one assembly) split by module
    for dotnet (docs/design/architecture-review.md step 2, docs/TESTING_LAYERS.md). Each core/Chem.<Module>.Tests
    project imports this and compiles its own list below. Sim is what's left, so a new test file runs in Sim until it
    is listed elsewhere, and no file can run twice or not at all. A file that needs another's helpers (ChemistryTests.R,
    ComboTests.Blank, LandmarkIntentTests.Village...) sits in that file's project or one that references it. Every
    project but Land references Shared (which references Game.Core); Land references Chem.Land alone, so its tests
    build on the land without the core (docs/design/chem-land-split.md, 5b); LandWorld references Land and Shared;
    Sim references Rules; Lockstep references Sim (ComboTests.Blank). Play, Rules and Playtest need nothing else. A
    reference that isn't in that list is a coupling: say why where it's added.
    The other test projects that import this for its settings and packages compile their own files, not these lists:
    Chem.Playtest.Tests (Scripts/Playtest/Editor) and Prototype.Plans.Tests (Scripts/Plans/Tests, on Prototype.Plans
    alone: docs/design/architecture-review.md step 6).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Fixtures run side by side, and they make whole worlds: on the workstation collector they wait on it, and run slower than one at a time (#162). -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ChemTests>$(MSBuildThisFileDirectory)../unity/Assets/Prototype/Chemistry/Tests/</ChemTests>
  </PropertyGroup>

  <ItemGroup>
    <!-- The fixture whose statics every other one uses (R, Folders, Room), a map made into a World (BuiltWorlds), and the attribute Unity needs. -->
    <ChemTestsShared Include="$(ChemTests)ChemistryTests.cs;$(ChemTests)BuiltWorlds.cs;$(ChemTests)NonParallelizable.cs" />

    <!-- The rule tables, mods, components, looks, the spell list and radial, a player's mods and stats. -->
    <ChemTestsRules Include="$(ChemTests)ComponentTests.cs;$(ChemTests)DownedTests.cs;$(ChemTests)FaunaTests.cs;$(ChemTests)GameFoldersTests.cs;$(ChemTests)ItemTests.cs;$(ChemTests)LookTests.cs;$(ChemTests)ModFieldTests.cs;$(ChemTests)PlayerModsTests.cs;$(ChemTests)PlayerStatsTests.cs;$(ChemTests)RadialTests.cs;$(ChemTests)RuleSwitchTests.cs;$(ChemTests)SpellBalanceTests.cs;$(ChemTests)SpellListTests.cs" />

    <!-- The land alone: hills, chunk generation, world plans, themes, biomes, map files, the land's folders (LandFolders). -->
    <ChemTestsLand Include="$(ChemTests)Hills*.cs;$(ChemTests)Map*.cs;$(ChemTests)WorldPlan*.cs;$(ChemTests)Landmark*.cs;$(ChemTests)Biome*.cs" />
    <ChemTestsLand Include="$(ChemTests)BakeTests.cs;$(ChemTests)ChunkGenTests.cs;$(ChemTests)ContourTests.cs;$(ChemTests)FarRingTests.cs;$(ChemTests)GroundPackTests.cs;$(ChemTests)LandFolders.cs;$(ChemTests)RoadGradeTests.cs;$(ChemTests)RowPadTests.cs;$(ChemTests)ScaleIslandTests.cs;$(ChemTests)SeaMaskTests.cs;$(ChemTests)ThemeTests.cs;$(ChemTests)VillageTests.cs;$(ChemTests)WorldGenTests.cs;$(ChemTests)WorldTwelveTests.cs" />

    <!-- The land on a World: a map's chunks made into one, laid stamps, terrain, the benches, and each land fixture's
         tests that run peers on a World (the *WorldTests.cs halves). Chem.Land.Tests builds on Chem.Land alone; these
         need Game.Core (docs/design/chem-land-split.md, 5b). -->
    <ChemTestsLandWorld Include="$(ChemTests)CellCostBench.cs;$(ChemTests)DrownedChainTests.cs;$(ChemTests)GeneratedSourceTests.cs;$(ChemTests)LaidRowTests.cs;$(ChemTests)LandStampTests.cs;$(ChemTests)LandmarkPicture.cs;$(ChemTests)MapSizeBench.cs;$(ChemTests)MapStampTests.cs;$(ChemTests)ModSwitchBench.cs;$(ChemTests)PlacesTests.cs;$(ChemTests)SparseWorldBench.cs;$(ChemTests)TerrainTests.cs;$(ChemTests)WorldBuildBench.cs" />
    <ChemTestsLandWorld Include="$(ChemTests)BakeWorldTests.cs;$(ChemTests)BiomeSketchWorldTests.cs;$(ChemTests)ChunkGenWorldTests.cs;$(ChemTests)FarRingWorldTests.cs;$(ChemTests)GroundPackWorldTests.cs;$(ChemTests)HillsForestWorldTests.cs;$(ChemTests)HillsRiversWorldTests.cs;$(ChemTests)HillsRoadsWorldTests.cs;$(ChemTests)HillsWorldTests.cs;$(ChemTests)LandmarkIntentWorldTests.cs;$(ChemTests)MapIdentityWorldTests.cs;$(ChemTests)MapWorldTests.cs;$(ChemTests)RoadGradeWorldTests.cs;$(ChemTests)ScaleIslandWorldTests.cs;$(ChemTests)SeaMaskWorldTests.cs;$(ChemTests)VillageWorldTests.cs;$(ChemTests)WorldPlanWorldTests.cs;$(ChemTests)WorldTwelveWorldTests.cs" />
    <ChemTestsLand Remove="@(ChemTestsLandWorld)" />

    <!-- The game modes on World: the Hold (its partial classes stay together), golf, the Gauntlet, puzzles, defense, the dragon. -->
    <ChemTestsPlay Include="$(ChemTests)Hold*.cs;$(ChemTests)AirTests.cs;$(ChemTests)CourseTests.cs;$(ChemTests)DefenseTests.cs;$(ChemTests)DragonTests.cs;$(ChemTests)GolfTests.cs;$(ChemTests)HandsTests.cs;$(ChemTests)PuzzleTests.cs" />

    <!-- Peers: the lockstep session and wire, late joins, rooms, resets, the open world over the loopback. -->
    <ChemTestsLockstep Include="$(ChemTests)LateJoinTests.cs;$(ChemTests)LockstepTests.cs;$(ChemTests)LockstepWireTests.cs;$(ChemTests)OnlineValleyTests.cs;$(ChemTests)OpenWorldTests.cs;$(ChemTests)ResetTests.cs;$(ChemTests)RoomSkyTests.cs;$(ChemTests)RoomTests.cs;$(ChemTests)StandKeeperTests.cs" />

    <!-- The rest: cells, chunks, ticks, spells, things, saves, hashes. -->
    <ChemTestsSim Include="$(ChemTests)*.cs" />
    <ChemTestsSim Remove="@(ChemTestsShared);@(ChemTestsRules);@(ChemTestsLand);@(ChemTestsLandWorld);@(ChemTestsPlay);@(ChemTestsLockstep)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Every core test project's: fixtures side by side (#162), and who may use this one's internal helpers. -->
    <Compile Include="$(MSBuildThisFileDirectory)TestParallel.cs" Link="TestParallel.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)TestFriends.cs" Link="TestFriends.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- NUnit 3, like Unity's Test Framework (NUnit 4 moved CollectionAssert). -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
