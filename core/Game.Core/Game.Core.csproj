<Project Sdk="Microsoft.NET.Sdk">
  <!-- docs/DECISIONS.md D3: the engine-free core. Compiles the Unity Chemistry
       assembly's sources (not its tests) from where Unity keeps them. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Game.Core</AssemblyName>
    <RootNamespace>Chem</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../unity/Assets/Prototype/Chemistry/*.cs" Link="Chemistry/%(Filename)%(Extension)" />
    <!-- The playtest bot's Unity-free logic (unity/Assets/Prototype/Scripts/Playtest/Logic, playtest/DESIGN.md). -->
    <Compile Include="../../unity/Assets/Prototype/Scripts/Playtest/Logic/*.cs" Link="Playtest/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Unity gets the same library from com.unity.nuget.newtonsoft-json. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
