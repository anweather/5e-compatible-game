<Project Sdk="Microsoft.NET.Sdk">
  <!-- docs/DECISIONS.md D3: the engine-free core. Compiles the Unity Chemistry
       assembly's sources (not its tests) from where Unity keeps them: the
       com.anweather.chemistry-core package (Runtime/, not Runtime/Land: that's
       Chem.Land), plus the game's Chemistry.Mcp. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Game.Core</AssemblyName>
    <RootNamespace>Chem</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../packages/com.anweather.chemistry-core/Runtime/*.cs" Link="Chemistry/%(Filename)%(Extension)" />
    <!-- The game modes' systems (Runtime/Play, architecture-review.md step 9): in the same assembly, as in Unity. -->
    <Compile Include="../../packages/com.anweather.chemistry-core/Runtime/Play/*.cs" Link="Play/%(Filename)%(Extension)" />
    <Compile Include="../../unity/Assets/Prototype/Chemistry/Mcp/*.cs" Link="Mcp/%(Filename)%(Extension)" />
    <!-- The playtest bot's Unity-free logic (unity/Assets/Prototype/Scripts/Shell/Playtest/Logic, playtest/DESIGN.md). -->
    <Compile Include="../../unity/Assets/Prototype/Scripts/Shell/Playtest/Logic/*.cs" Link="Playtest/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The land, its own assembly below this one (Chem.Land, Runtime/Land). -->
    <ProjectReference Include="../Chem.Land/Chem.Land.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Unity gets the same library from com.unity.nuget.newtonsoft-json. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
