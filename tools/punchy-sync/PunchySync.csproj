<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pulls Punchy's creatures into rules/fauna.json and rules/parts.json (README.md). A tool, not
       part of the game: it lives outside core/ and isn't built by CI. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>PunchySync</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
