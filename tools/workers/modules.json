    { "name": "core-mcp-tests", "projects": ["Rules.Mcp.Tests"], "paths": ["core/Rules.Mcp.Tests/**"] },
    { "name": "core-hold-runner-tests", "projects": ["Hold.Runner.Tests"], "paths": ["core/Hold.Runner.Tests/**"] },
    { "name": "core-playtest-runner-tests", "projects": ["Playtest.Runner.Tests"], "paths": ["core/Playtest.Runner.Tests/**"] },
    { "name": "core-chat-bench-tests", "projects": ["Chat.Bench.Tests"], "paths": ["core/Chat.Bench.Tests/**"] },
    { "name": "core-shared-tests", "projects": ["Chem.Shared.Tests"], "paths": ["core/Chem.Shared.Tests/**"] },
    { "name": "core-rules-tests", "projects": ["Chem.Rules.Tests"], "paths": ["core/Chem.Rules.Tests/**"] },
    { "name": "core-land-tests", "projects": ["Chem.Land.Tests"], "paths": ["core/Chem.Land.Tests/**"] },
    { "name": "core-land-world-tests", "projects": ["Chem.LandWorld.Tests"], "paths": ["core/Chem.LandWorld.Tests/**"] },
