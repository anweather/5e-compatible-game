    { "name": "core-playtest-tests", "projects": ["Chem.Playtest.Tests"], "paths": ["core/Chem.Playtest.Tests/**"] },

    { "name": "rules", "paths": ["rules/**"],
      "reads": ["Chem.Shared.Tests", "Chem.Rules.Tests", "Chem.Land.Tests", "Chem.LandWorld.Tests", "Chem.Sim.Tests", "Chem.Play.Tests", "Chem.Lockstep.Tests", "Chem.Playtest.Tests", "Rules.Mcp.Tests", "Hold.Runner.Tests", "Chat.Bench.Tests"],
      "_": "Every test that loads ChemistryTests.R, Rules.Mcp's tools, the Hold curve; not Playtest.Runner.Tests (no rules)." },
    { "name": "world", "paths": ["world/**"],
      "reads": ["Chem.Shared.Tests", "Chem.Rules.Tests", "Chem.Land.Tests", "Chem.LandWorld.Tests", "Chem.Sim.Tests", "Chem.Play.Tests", "Chem.Lockstep.Tests", "Chem.Playtest.Tests", "Rules.Mcp.Tests", "Hold.Runner.Tests", "Chat.Bench.Tests"],
