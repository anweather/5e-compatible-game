# Analyzer severities for our C# (see docs/QUALITY.md).
#
# Unity 6.3 passes this file to the compiler for every assembly (it does not
# read .editorconfig). The analyzers themselves live in
# Assets/Prototype/Analyzers and only run on our assemblies. The CI build of
# core/ (Game.Core) reads this same file, so a rule means the same thing in
# the Unity console and on GitHub.
#
# Severities: error | warning | suggestion (info, hidden in Unity's console) | none.
# Keep "error" out of this file: an error stops Unity compiling the game.
# CI turns every warning into an error for Game.Core instead.

is_global = true

# ---------- turned off, with the reason ----------

# Public fields: the rule tables are plain JSON data classes and Unity
# serializes public fields; both are intended.
dotnet_diagnostic.S1104.severity = none
dotnet_diagnostic.CA1051.severity = none

# "Move into a named namespace": Unity MonoBehaviours here live in the global
# namespace on purpose (scene files reference them by class name).
dotnet_diagnostic.S3903.severity = none
dotnet_diagnostic.CA1050.severity = none

# Assembly version attributes: Unity builds the assemblies, nobody versions them.
dotnet_diagnostic.S3904.severity = none

# "Use LINQ instead of the loop": the chemistry tick is hot game code; plain
# loops avoid per-tick allocations.
dotnet_diagnostic.S3267.severity = none

# Empty class: an empty MonoBehaviour is Unity's normal "tag" component (Water).
dotnet_diagnostic.S2094.severity = none

# Duplicates of Sonar rules we keep (S6608), so each problem shows once.
dotnet_diagnostic.CA1826.severity = none

# "Make this member static": S2325 doesn't know Unity calls messages such as
# Start or OnDestroy on an instance, so it flags them; CA1822 is the same check
# and the Unity analyzers suppress it on Unity messages. Keep CA1822, drop S2325.
dotnet_diagnostic.S2325.severity = none

# CA1307 asks for a StringComparison on Replace/IndexOf/Contains, which are
# already ordinal; CA1309/CA1310 below catch the culture-sensitive calls.
dotnet_diagnostic.CA1307.severity = none

# Constant array arguments: fires on test expected-value arrays, where a
# static field would only hurt readability.
dotnet_diagnostic.CA1861.severity = none

# Style-only .NET suggestions that don't pay for themselves here.
dotnet_diagnostic.CA1852.severity = none
dotnet_diagnostic.CA1859.severity = none

# ---------- turned up: worth a warning ----------

# Culture-dependent string calls: results can differ between players' machines,
# which breaks the deterministic core (docs/DECISIONS.md D3).
dotnet_diagnostic.CA1304.severity = warning
dotnet_diagnostic.CA1305.severity = warning
dotnet_diagnostic.CA1309.severity = warning
dotnet_diagnostic.CA1310.severity = warning

# Members that could be static (see S2325 above for why this one, not Sonar's).
dotnet_diagnostic.CA1822.severity = warning

# Unused code and complexity (Sonar defaults, listed so they are explicit).
dotnet_diagnostic.S1144.severity = warning
dotnet_diagnostic.S1481.severity = warning
dotnet_diagnostic.S1172.severity = warning
dotnet_diagnostic.S4487.severity = warning
dotnet_diagnostic.S1854.severity = warning
dotnet_diagnostic.S125.severity = warning
dotnet_diagnostic.S3776.severity = warning
dotnet_diagnostic.S107.severity = warning
dotnet_diagnostic.S1871.severity = warning
dotnet_diagnostic.S4144.severity = warning

# Unity analyzers (Microsoft.Unity.Analyzers). Most default to "info", which
# Unity's console never shows, so raise them all. UNT0021 (prefer protected
# Unity messages) is left off: it is a style preference.
dotnet_diagnostic.UNT0001.severity = warning
dotnet_diagnostic.UNT0002.severity = warning
dotnet_diagnostic.UNT0003.severity = warning
dotnet_diagnostic.UNT0004.severity = warning
dotnet_diagnostic.UNT0005.severity = warning
dotnet_diagnostic.UNT0006.severity = warning
dotnet_diagnostic.UNT0007.severity = warning
dotnet_diagnostic.UNT0008.severity = warning
dotnet_diagnostic.UNT0009.severity = warning
