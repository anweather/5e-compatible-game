# Unity: generated and per-machine folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset Store packs: listed in AssetPacks.json and restored with
# Prototype > Restore Asset Packs, never committed
/Assets/Starter Assets/
/Assets/Starter Assets.meta
/Assets/UnityTechnologies/
/Assets/UnityTechnologies.meta
/Assets/TerrainSampleAssets/
/Assets/TerrainSampleAssets.meta
/Assets/TerrainDemoScene_URP/
/Assets/TerrainDemoScene_URP.meta
/Assets/Free Pack/
/Assets/Free Pack.meta

# Built by Prototype > Build Chemistry Yard from Asset Store content; not redistributable
/Assets/Prototype/Generated/
/Assets/Prototype/Generated.meta

# The yard scene is generated too (YardAutoBuild builds it when missing).
# ChemYardBuilder writes its .meta with a fixed GUID, so the build settings
# entry never changes.
/Assets/Prototype/Scenes/ChemistryYard.unity
/Assets/Prototype/Scenes/ChemistryYard.unity.meta

# Netcode's auto-generated prefab list. Its generation is off
# (ProjectSettings/NetcodeForGameObjects.asset), but an Editor that was open
# when that setting was pulled can still write one.
/Assets/DefaultNetworkPrefabs.asset
/Assets/DefaultNetworkPrefabs.asset.meta

# Copied from ../rules by PrototypeBuild before each player build
/Assets/StreamingAssets/
/Assets/StreamingAssets.meta

# IDE files Unity regenerates
.vs/
.vsconfig
.vscode/
.idea/
*.csproj
*.sln
*.slnx
*.user
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.suo
*.tmp
*.userprefs
*.unityproj
*.pidb.meta
*.pdb.meta
*.mdb.meta
ExportedObj/
.consulo/
.gradle/
*.DotSettings.user
/[Aa]ssets/Plugins/Editor/JetBrains*

# OS and crash files
.DS_Store
sysinfo.txt
crashlytics-build.properties
mono_crash.*
*.log

# More that Unity generates (from GitHub's Unity.gitignore)
.utmp/
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
/[Aa]ssets/[Ss]ceneDependencyCache*
/UIElementsSchema/

# Player builds outside Builds/
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
