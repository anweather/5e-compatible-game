    {"id": "ash-skirt", "kind": "zone", "biome": "ashflats", "at": "northeast", "distance": "mid", "size": "large", "stretch": 1.4, "near": "volcanic-land"},
    {"id": "lava-lake", "kind": "lake", "at": "northeast", "distance": "far", "size": "medium", "material": "lava", "island": {"size": "small", "biome": "ashflats"}, "near": "volcanic-land"},
    {"id": "lava-river", "kind": "river", "from": "northeast", "to": "south", "meander": "medium", "width": "medium", "material": "lava", "through": ["lava-lake"]},
    {"id": "volcano-heat", "kind": "influence", "look": "ashplains", "around": "volcanic-land", "reach": 0.75, "falloff": 1, "strength": 1},
    {"id": "lava-scorch", "kind": "influence", "look": "ashplains", "along": "lava-river", "reach": 0.07, "falloff": 0.7, "strength": 0.9}
  ]
